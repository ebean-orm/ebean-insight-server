            <div class="chartjs-wrap">
              <canvas id="datasource-pool-timing-chart"></canvas>
              <div id="datasource-pool-timing-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="datasource-pool-timing-legend" class="top-chart-legend"
                 data-label-state="datasourcePoolTimingLabels" aria-label="Datasource pool timing series legend"></div>
          </article>
        </div>
      {{/datasourcePoolDashboard}}

      {{#jvmDashboard}}
        <div class="jvm-grid">
          <article class="query-total-section jvm-section" data-chart-id="jvm-memory">
            <header class="chart-section-header chart-no-controls">JVM memory by pod <button type="button" class="chart-expand-btn" data-chart-zoom="jvm-memory" aria-label="Expand JVM memory chart" title="Expand chart">↗</button></header>
            <div class="chartjs-wrap">
              <canvas id="jvm-memory-chart"></canvas>
              <div id="jvm-memory-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="jvm-memory-legend" class="top-chart-legend jvm-legend"
                 data-label-state="jvmMemoryLabels" aria-label="JVM memory pod legend"></div>
          </article>
          <article class="query-total-section jvm-section" data-chart-id="jvm-cpu">
            <header class="chart-section-header chart-no-controls">JVM CPU usage (user + system) <button type="button" class="chart-expand-btn" data-chart-zoom="jvm-cpu" aria-label="Expand JVM CPU chart" title="Expand chart">↗</button></header>
            <div class="chartjs-wrap">
              <canvas id="jvm-cpu-chart"></canvas>
              <div id="jvm-cpu-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="jvm-cpu-legend" class="top-chart-legend jvm-legend"
                 data-label-state="jvmCpuLabels" aria-label="JVM CPU pod legend"></div>
          </article>
        </div>
      {{/jvmDashboard}}
