{{<fragments/layout}}
  {{$filters}}
    <form class="header-filters" method="get" action="/ux/top">
      {{#compactLayout}}<input type="hidden" name="layout" value="compact">{{/compactLayout}}
      <div id="custom-range-controls" class="custom-range-controls" hidden>
        <label>
          <input type="datetime-local" id="custom-range-from" aria-label="Custom range start">
        </label>
        <label>
          <input type="datetime-local" id="custom-range-to" aria-label="Custom range end">
        </label>
        <button type="submit" class="custom-range-apply">Apply</button>
      </div>
      <select name="app" aria-label="Application" onchange="this.form.requestSubmit()">
        {{#apps}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/apps}}
      </select>
      <select name="env" aria-label="Environment" onchange="this.form.requestSubmit()">
        {{#envs}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/envs}}
      </select>
      <select name="range" aria-label="Time range" onchange="this.form.requestSubmit()">
        {{#ranges}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/ranges}}
      </select>
      <select name="tz" id="time-zone-select" aria-label="Chart timezone"
              onchange="this.form.requestSubmit()">
        <option value="browser">Browser time</option>
        <option value="utc">UTC</option>
      </select>
      <label id="auto-refresh-control" class="auto-refresh-control" hidden>
        <input type="checkbox" id="auto-refresh-toggle" aria-label="Enable automatic refresh">
        Auto
        <span class="auto-refresh-timer" aria-label="Seconds until refresh">
          <span id="auto-refresh-ring" class="auto-refresh-ring" aria-hidden="true"></span>
          <span id="auto-refresh-seconds">60s</span>
        </span>
        <span id="auto-refresh-status" class="auto-refresh-status" hidden></span>
      </label>
      <noscript><button type="submit">Apply</button></noscript>
    </form>
  {{/filters}}
  {{$body}}
    <link rel="stylesheet" href="/static/query-total.css?v=60">

    {{^hasData}}
      <article>
        <p>No data for the selected application / environment / range.</p>
      </article>
    {{/hasData}}

    {{#hasData}}
      <div class="top-dashboard{{#compactLayout}} top-dashboard-compact compact-chart-controls-hidden{{/compactLayout}}">
        <div class="dashboard-view-toolbar" role="toolbar" aria-label="Dashboard view controls">
          <button type="button" id="layout-toggle" class="layout-toggle" aria-pressed="{{compactLayout}}"
                  aria-label="{{#compactLayout}}Use normal layout{{/compactLayout}}{{^compactLayout}}Use compact layout{{/compactLayout}}"
                  title="{{#compactLayout}}Use normal layout{{/compactLayout}}{{^compactLayout}}Use compact layout{{/compactLayout}}">
            {{#compactLayout}}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="2" y="2" width="5" height="5" rx="1"></rect>
                <rect x="9" y="2" width="5" height="5" rx="1"></rect>
                <rect x="17" y="2" width="5" height="5" rx="1"></rect>
                <rect x="2" y="9" width="5" height="5" rx="1"></rect>
                <rect x="9" y="9" width="5" height="5" rx="1"></rect>
                <rect x="17" y="9" width="5" height="5" rx="1"></rect>
                <rect x="2" y="17" width="5" height="5" rx="1"></rect>
                <rect x="9" y="17" width="5" height="5" rx="1"></rect>
                <rect x="17" y="17" width="5" height="5" rx="1"></rect>
              </svg>
            {{/compactLayout}}
            {{^compactLayout}}
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="2" y="2" width="9" height="9" rx="1"></rect>
                <rect x="13" y="2" width="9" height="9" rx="1"></rect>
                <rect x="2" y="13" width="9" height="9" rx="1"></rect>
                <rect x="13" y="13" width="9" height="9" rx="1"></rect>
              </svg>
            {{/compactLayout}}
          </button>
          {{#compactLayout}}
            <button type="button" id="compact-chart-controls-toggle" class="layout-toggle" aria-pressed="false"
                    aria-label="Show chart controls" title="Show chart controls">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 18h16"></path>
                <circle cx="9" cy="6" r="2"></circle>
                <circle cx="15" cy="12" r="2"></circle>
                <circle cx="7" cy="18" r="2"></circle>
              </svg>
            </button>
            <button type="button" id="compact-legends-toggle" class="layout-toggle" aria-pressed="false"
                    aria-label="Show legends" title="Show legends">
              <svg class="legend-key-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="5" cy="6" r="1.5"></circle>
                <circle cx="5" cy="12" r="1.5"></circle>
                <circle cx="5" cy="18" r="1.5"></circle>
                <path d="M9 6h10"></path>
                <path d="M9 12h10"></path>
                <path d="M9 18h10"></path>
              </svg>
            </button>
          {{/compactLayout}}
          <button type="button" id="all-chart-labels-toggle"
                  class="layout-toggle legend-label-global-toggle" aria-pressed="false"
                  aria-label="Show series names on all charts"
                  title="Show series names on all charts" hidden>
            <span class="legend-label-icon" aria-hidden="true">A</span>
          </button>
        </div>
      {{#webApiDashboard}}
        <div class="web-api-grid web-api-primary-grid">
          <article class="query-total-section" data-chart-id="web-api-total">
            <header class="chart-section-header" role="toolbar" aria-label="Web API total chart controls">
              <span class="chart-title">Web API total time <small id="web-api-total-rate" class="chart-rate-centered">{{webApiRate}} req/s&nbsp;&nbsp;load: {{webApiLoad}}</small></span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="web-api-total" aria-label="Expand Web API total time chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start
                           series-chart-controls">
                <button type="button" id="web-api-chart-type-bar" class="chart-type-btn" aria-pressed="true">Bars</button>
                <button type="button" id="web-api-chart-type-line" class="chart-type-btn" aria-pressed="false">Lines</button>
                <button type="button" class="chart-type-btn series-table-toggle"
                        aria-expanded="false" aria-controls="web-api-series-table">Table</button>
              </span>
            </header>
            <div class="chartjs-wrap">
              <canvas id="web-api-chart"></canvas>
              <div id="web-api-total-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div class="top-chart-legend timer-dashboard-legend web-api-legend"
                 data-label-state="webTotalLabels" aria-label="Web API series legend">
              {{#webApiGroups}}
                <button type="button" class="legend-series-toggle timer-dashboard-series-toggle web-api-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                  <span class="legend-label">{{.}}</span>
                </button>
              {{/webApiGroups}}
            </div>
            <div id="web-api-range-selection" class="chart-range-selection" hidden>
              <span id="web-api-range-selection-text"></span>
              <button type="button" id="web-api-range-selection-clear">Use preset range</button>
            </div>
          </article>
          <article class="query-total-section" data-chart-id="web-api-statistics">
            <header class="chart-section-header" role="toolbar" aria-label="Web API statistics chart controls">
              <span>Web API statistics</span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="web-api-statistics" aria-label="Expand Web API statistics chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start">
                <button type="button" id="web-api-mean-mode-both" class="chart-type-btn" aria-pressed="true">Mean + Max</button>
                <button type="button" id="web-api-mean-mode-only" class="chart-type-btn" aria-pressed="false">Mean</button>
                <button type="button" id="web-api-mean-mode-max" class="chart-type-btn" aria-pressed="false">Max</button>
                <button type="button" id="web-api-mean-mode-count" class="chart-type-btn" aria-pressed="false">Count</button>
              </span>
              <span id="web-api-mean-view-group" class="chart-control-group chart-mode-tabs">
                <button type="button" id="web-api-mean-view-dots" class="chart-type-btn" aria-pressed="true">Dots</button>
                <button type="button" id="web-api-mean-view-lines" class="chart-type-btn" aria-pressed="false">Lines</button>
              </span>
              <label id="web-api-mean-scale-group" class="chart-scale-toggle">
                <input type="checkbox" id="web-api-mean-scale-log" aria-label="Use logarithmic scale">
                Log scale
              </label>
            </header>
            <div class="chartjs-wrap">
              <canvas id="web-api-mean-max-chart"></canvas>
              <div id="web-api-mean-max-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div class="top-chart-legend timer-dashboard-legend web-api-legend"
                 data-label-state="webStatisticsLabels" aria-label="Web API series legend">
              {{#webApiGroups}}
                <button type="button" class="legend-series-toggle timer-dashboard-series-toggle web-api-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                  <span class="legend-label">{{.}}</span>
                </button>
              {{/webApiGroups}}
            </div>
          </article>
        </div>
        <article class="query-total-section series-table-view" id="web-api-series-table"
                 data-series-table data-family="web-api" data-view-param="webTotalView"
                 data-count-label="Requests" data-rate-label="req/s"
                 aria-label="Web API total time series table" hidden>
          <header class="series-table-panel-header">Web API total time series</header>
        </article>
      {{/webApiDashboard}}

      {{#appComponentDashboard}}
        <div class="timer-dashboard-grid timer-dashboard-primary-grid app-component-grid">
          <article class="query-total-section" data-chart-id="component-total">
            <header class="chart-section-header" role="toolbar" aria-label="Application component total chart controls">
              <span class="chart-title">Application component total time <small id="component-total-rate" class="chart-rate-centered">{{appComponentRate}} calls/s&nbsp;&nbsp;load: {{appComponentLoad}}</small></span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="component-total" aria-label="Expand application component total time chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start series-chart-controls">
                <button type="button" id="component-chart-type-bar" class="chart-type-btn" aria-pressed="true">Bars</button>
                <button type="button" id="component-chart-type-line" class="chart-type-btn" aria-pressed="false">Lines</button>
                <button type="button" class="chart-type-btn series-table-toggle"
                        aria-expanded="false" aria-controls="app-component-series-table">Table</button>
              </span>
            </header>
            <div class="chartjs-wrap">
              <canvas id="component-chart"></canvas>
              <div id="component-total-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="component-range-selection" class="chart-range-selection" hidden>
              <span id="component-range-selection-text"></span>
              <button type="button" id="component-range-selection-clear">Use preset range</button>
            </div>
            <div class="top-chart-legend timer-dashboard-legend component-legend"
                 data-label-state="componentTotalLabels" aria-label="App component series legend">
              {{#appComponentGroups}}
                <button type="button" class="legend-series-toggle timer-dashboard-series-toggle component-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                  <span class="legend-label">{{.}}</span>
                </button>
              {{/appComponentGroups}}
            </div>
          </article>
          <article class="query-total-section" data-chart-id="component-statistics">
            <header class="chart-section-header" role="toolbar" aria-label="App component statistics chart controls">
              <span>Application component statistics</span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="component-statistics" aria-label="Expand application component statistics chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start">
                <button type="button" id="component-mean-mode-both" class="chart-type-btn" aria-pressed="true">Mean + Max</button>
                <button type="button" id="component-mean-mode-only" class="chart-type-btn" aria-pressed="false">Mean</button>
                <button type="button" id="component-mean-mode-max" class="chart-type-btn" aria-pressed="false">Max</button>
                <button type="button" id="component-mean-mode-count" class="chart-type-btn" aria-pressed="false">Count</button>
              </span>
              <span id="component-mean-view-group" class="chart-control-group chart-mode-tabs">
                <button type="button" id="component-mean-view-dots" class="chart-type-btn" aria-pressed="true">Dots</button>
                <button type="button" id="component-mean-view-lines" class="chart-type-btn" aria-pressed="false">Lines</button>
              </span>
              <label id="component-mean-scale-group" class="chart-scale-toggle">
                <input type="checkbox" id="component-mean-scale-log" aria-label="Use logarithmic scale">
                Log scale
              </label>
            </header>
            <div class="chartjs-wrap">
              <canvas id="component-mean-max-chart"></canvas>
              <div id="component-mean-max-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div class="top-chart-legend timer-dashboard-legend component-legend"
                 data-label-state="componentStatisticsLabels" aria-label="App component series legend">
              {{#appComponentGroups}}
                <button type="button" class="legend-series-toggle timer-dashboard-series-toggle component-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                  <span class="legend-label">{{.}}</span>
                </button>
              {{/appComponentGroups}}
            </div>
          </article>
        </div>
        <article class="query-total-section series-table-view" id="app-component-series-table"
                 data-series-table data-family="app-component" data-view-param="componentTotalView"
                 data-count-label="Calls" data-rate-label="calls/s"
                 aria-label="Application component total time series table" hidden>
          <header class="series-table-panel-header">Application component total time series</header>
        </article>
      {{/appComponentDashboard}}

      <div class="top-primary-grid"{{^queryDashboard}} hidden{{/queryDashboard}}>
        <div class="top-primary-column">
          <article class="query-total-section" data-chart-id="query-total">
            <header class="chart-section-header" role="toolbar" aria-label="Query total time chart controls">
              <span class="chart-title">Query total time <small id="query-total-rate" class="chart-rate-centered">{{queryRate}} qry/s&nbsp;&nbsp;load: {{queryLoad}}</small></span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="query-total" aria-label="Expand query total time chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start
                           series-chart-controls">
                <button type="button" id="chart-type-bar" class="chart-type-btn" aria-pressed="true">Bars</button>
                <button type="button" id="chart-type-line" class="chart-type-btn" aria-pressed="false">Lines</button>
                <button type="button" class="chart-type-btn series-table-toggle"
                        aria-expanded="false" aria-controls="query-series-table">Table</button>
              </span>
            </header>
            <div class="chartjs-wrap">
              <canvas id="chartjs-canvas"></canvas>
              <div id="query-total-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="chart-range-selection" class="chart-range-selection" hidden>
              <span id="chart-range-selection-text"></span>
              <button type="button" id="chart-range-selection-clear">Use preset range</button>
            </div>
          </article>

          <div class="top-chart-legend" data-chart-legend="query-total"
               data-label-state="queryTotalLabels" aria-label="Chart series legend">
            {{#legend}}
              <button type="button" class="legend-series-toggle"
                      data-label="{{group}}" aria-pressed="true"
                      aria-label="Toggle {{group}}" title="{{group}}">
                <span class="legend-swatch" style="background-color: {{color}};"></span>
                <span class="legend-label">{{group}}</span>
              </button>
            {{/legend}}
          </div>

        </div>

        <div class="top-primary-column">
          <article class="query-total-section" data-chart-id="query-statistics">
            <header class="chart-section-header" role="toolbar" aria-label="Mean and Max chart controls">
              <span>Query statistics</span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="query-statistics" aria-label="Expand query statistics chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start">
                <button type="button" id="top-mean-mode-both" class="chart-type-btn"
                        aria-pressed="true">Mean + Max</button>
                <button type="button" id="top-mean-mode-only" class="chart-type-btn"
                        aria-pressed="false">Mean</button>
                <button type="button" id="top-mean-mode-max" class="chart-type-btn"
                        aria-pressed="false">Max</button>
                <button type="button" id="top-mean-mode-count" class="chart-type-btn"
                        aria-pressed="false">Count</button>
              </span>
              <span id="top-mean-view-group" class="chart-control-group chart-mode-tabs">
                <button type="button" id="top-mean-view-dots" class="chart-type-btn"
                        aria-pressed="true">Dots</button>
                <button type="button" id="top-mean-view-lines" class="chart-type-btn"
                        aria-pressed="false">Lines</button>
              </span>
              <label class="chart-scale-toggle">
                <input type="checkbox" id="top-mean-scale-log"
                       aria-label="Use logarithmic scale">
                Log scale
              </label>
            </header>
            <div class="chartjs-wrap">
              <canvas id="top-mean-max-chart"></canvas>
              <div id="query-statistics-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
          </article>

          <div class="top-chart-legend" data-chart-legend="query-statistics"
               data-label-state="queryStatisticsLabels" aria-label="Chart series legend">
            {{#legend}}
              <button type="button" class="legend-series-toggle"
                      data-label="{{group}}" aria-pressed="true"
                      aria-label="Toggle {{group}}" title="{{group}}">
                <span class="legend-swatch" style="background-color: {{color}};"></span>
                <span class="legend-label">{{group}}</span>
              </button>
            {{/legend}}
          </div>
        </div>

        <article class="query-total-section series-table-view" id="query-series-table"
                 data-series-table data-family="query" data-view-param="queryTotalView"
                 data-count-label="Executions" data-rate-label="qry/s" data-hash-count="true"
                 aria-label="Query total time series table" hidden>
          <header class="series-table-panel-header">Query total time series</header>
        </article>

      </div>

      {{#showTopRankings}}
        <div class="top-ranking-grid">
          <article class="query-total-section" data-chart-id="top-by-time">
            <header class="chart-section-header chart-no-controls">Top by time <button type="button" class="chart-expand-btn" data-chart-zoom="top-by-time" aria-label="Expand top by time chart" title="Expand chart">↗</button></header>
            <div class="ranking-chart-wrap">
              <canvas id="top-by-time-chart"></canvas>
            </div>
          </article>
          <article class="query-total-section" data-chart-id="top-by-mean">
            <header class="chart-section-header chart-no-controls">Top by mean <button type="button" class="chart-expand-btn" data-chart-zoom="top-by-mean" aria-label="Expand top by mean chart" title="Expand chart">↗</button></header>
            <div class="ranking-chart-wrap">
              <canvas id="top-by-mean-chart"></canvas>
            </div>
          </article>
        </div>
      {{/showTopRankings}}

      {{#dmlDashboard}}
        <div class="web-api-grid web-api-primary-grid dml-grid">
          <article class="query-total-section" data-chart-id="dml-total">
            <header class="chart-section-header" role="toolbar" aria-label="DML total chart controls">
              <span class="chart-title">DML total time <small id="dml-total-rate" class="chart-rate-centered">{{dmlRate}} op/s&nbsp;&nbsp;load: {{dmlLoad}}</small></span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="dml-total" aria-label="Expand DML total time chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start
                           series-chart-controls">
                <button type="button" id="dml-chart-type-bar" class="chart-type-btn" aria-pressed="true">Bars</button>
                <button type="button" id="dml-chart-type-line" class="chart-type-btn" aria-pressed="false">Lines</button>
                <button type="button" class="chart-type-btn series-table-toggle"
                        aria-expanded="false" aria-controls="dml-series-table">Table</button>
              </span>
            </header>
            <div class="chartjs-wrap">
              <canvas id="dml-chart"></canvas>
              <div id="dml-total-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="dml-range-selection" class="chart-range-selection" hidden>
              <span id="dml-range-selection-text"></span>
              <button type="button" id="dml-range-selection-clear">Use preset range</button>
            </div>
            <div class="top-chart-legend timer-dashboard-legend dml-legend"
                 data-label-state="dmlTotalLabels" aria-label="DML series legend">
              {{#dmlGroups}}
                <button type="button" class="legend-series-toggle timer-dashboard-series-toggle dml-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                  <span class="legend-label">{{.}}</span>
                </button>
              {{/dmlGroups}}
            </div>
          </article>
          <article class="query-total-section" data-chart-id="dml-statistics">
            <header class="chart-section-header" role="toolbar" aria-label="DML statistics chart controls">
              <span>DML statistics</span>
              <button type="button" class="chart-expand-btn" data-chart-zoom="dml-statistics" aria-label="Expand DML statistics chart" title="Expand chart">↗</button>
              <span class="chart-control-group chart-mode-tabs chart-controls-start">
                <button type="button" id="dml-mean-mode-both" class="chart-type-btn" aria-pressed="true">Mean + Max</button>
                <button type="button" id="dml-mean-mode-only" class="chart-type-btn" aria-pressed="false">Mean</button>
                <button type="button" id="dml-mean-mode-max" class="chart-type-btn" aria-pressed="false">Max</button>
                <button type="button" id="dml-mean-mode-count" class="chart-type-btn" aria-pressed="false">Count</button>
              </span>
              <span id="dml-mean-view-group" class="chart-control-group chart-mode-tabs">
                <button type="button" id="dml-mean-view-dots" class="chart-type-btn" aria-pressed="true">Dots</button>
                <button type="button" id="dml-mean-view-lines" class="chart-type-btn" aria-pressed="false">Lines</button>
              </span>
              <label id="dml-mean-scale-group" class="chart-scale-toggle">
                <input type="checkbox" id="dml-mean-scale-log" aria-label="Use logarithmic scale">
                Log scale
              </label>
            </header>
            <div class="chartjs-wrap">
              <canvas id="dml-mean-max-chart"></canvas>
              <div id="dml-mean-max-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div class="top-chart-legend timer-dashboard-legend dml-legend"
                 data-label-state="dmlStatisticsLabels" aria-label="DML series legend">
              {{#dmlGroups}}
                <button type="button" class="legend-series-toggle timer-dashboard-series-toggle dml-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                  <span class="legend-label">{{.}}</span>
                </button>
              {{/dmlGroups}}
            </div>
          </article>
        </div>
        <article class="query-total-section series-table-view" id="dml-series-table"
