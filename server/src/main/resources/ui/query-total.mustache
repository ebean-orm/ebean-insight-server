{{<fragments/layout}}
  {{$filters}}
    <form class="header-filters" method="get" action="/ux/top">
      <div id="custom-range-controls" class="custom-range-controls" hidden>
        <label>
          <input type="datetime-local" id="custom-range-from" aria-label="Custom range start">
        </label>
        <label>
          <input type="datetime-local" id="custom-range-to" aria-label="Custom range end">
        </label>
        <button type="submit" class="custom-range-apply">Apply</button>
      </div>
      <select name="app" aria-label="Application" onchange="this.form.requestSubmit()">
        {{#apps}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/apps}}
      </select>
      <select name="env" aria-label="Environment" onchange="this.form.requestSubmit()">
        {{#envs}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/envs}}
      </select>
      <select name="range" aria-label="Time range" onchange="this.form.requestSubmit()">
        {{#ranges}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/ranges}}
      </select>
      <select name="tz" id="time-zone-select" aria-label="Chart timezone"
              onchange="this.form.requestSubmit()">
        <option value="browser">Browser time</option>
        <option value="utc">UTC</option>
      </select>
      <label id="auto-refresh-control" class="auto-refresh-control" hidden>
        <input type="checkbox" id="auto-refresh-toggle" aria-label="Enable automatic refresh">
        Auto-refresh
        <span class="auto-refresh-timer" aria-label="Seconds until refresh">
          <span id="auto-refresh-ring" class="auto-refresh-ring" aria-hidden="true"></span>
          <span id="auto-refresh-seconds">60s</span>
        </span>
        <span id="auto-refresh-status" class="auto-refresh-status" hidden></span>
      </label>
      <noscript><button type="submit">Apply</button></noscript>
    </form>
  {{/filters}}
  {{$body}}
    <link rel="stylesheet" href="/static/query-total.css?v=15">

    {{^hasData}}
      <article>
        <p>No data for the selected application / environment / range.</p>
      </article>
    {{/hasData}}

    {{#hasData}}
      {{#webApiDashboard}}
        <div class="web-api-grid web-api-primary-grid">
          <article class="query-total-section">
            <header class="chart-section-header" role="toolbar" aria-label="Web API total chart controls">
              <span class="chart-title">Web API total time <small id="web-api-total-rate" class="chart-rate-centered">{{webApiRate}} req/s&nbsp;&nbsp;load: {{webApiLoad}}</small></span>
              <span class="chart-control-group chart-mode-tabs">
                <button type="button" id="web-api-chart-type-bar" class="chart-type-btn" aria-pressed="true">Bars</button>
                <button type="button" id="web-api-chart-type-line" class="chart-type-btn" aria-pressed="false">Lines</button>
              </span>
            </header>
            <div class="chartjs-wrap">
              <canvas id="web-api-chart"></canvas>
              <div id="web-api-total-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div class="top-chart-legend web-api-legend" aria-label="Web API series legend">
              {{#webApiGroups}}
                <button type="button" class="legend-series-toggle web-api-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                </button>
              {{/webApiGroups}}
            </div>
            <div id="web-api-range-selection" class="chart-range-selection" hidden>
              <span id="web-api-range-selection-text"></span>
              <button type="button" id="web-api-range-selection-clear">Use preset range</button>
            </div>
          </article>
          <article class="query-total-section">
            <header class="chart-section-header" role="toolbar" aria-label="Web API statistics chart controls">
              <span>Web API statistics</span>
              <span class="chart-control-group chart-mode-tabs">
                <button type="button" id="web-api-mean-mode-both" class="chart-type-btn" aria-pressed="true">Mean + Max</button>
                <button type="button" id="web-api-mean-mode-only" class="chart-type-btn" aria-pressed="false">Mean</button>
                <button type="button" id="web-api-mean-mode-max" class="chart-type-btn" aria-pressed="false">Max</button>
                <button type="button" id="web-api-mean-mode-count" class="chart-type-btn" aria-pressed="false">Count</button>
              </span>
              <span id="web-api-mean-view-group" class="chart-control-group chart-mode-tabs">
                <button type="button" id="web-api-mean-view-dots" class="chart-type-btn" aria-pressed="true">Dots</button>
                <button type="button" id="web-api-mean-view-lines" class="chart-type-btn" aria-pressed="false">Lines</button>
              </span>
              <label id="web-api-mean-scale-group" class="chart-scale-toggle">
                <input type="checkbox" id="web-api-mean-scale-log" aria-label="Use logarithmic scale">
                Log scale
              </label>
            </header>
            <div class="chartjs-wrap">
              <canvas id="web-api-mean-max-chart"></canvas>
              <div id="web-api-mean-max-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div class="top-chart-legend web-api-legend" aria-label="Web API series legend">
              {{#webApiGroups}}
                <button type="button" class="legend-series-toggle web-api-series-toggle"
                        data-label="{{.}}" aria-pressed="true" aria-label="Toggle {{.}}" title="{{.}}">
                  <span class="legend-swatch"></span>
                </button>
              {{/webApiGroups}}
            </div>
          </article>
        </div>
      {{/webApiDashboard}}

      <div class="top-primary-grid">
        <div class="top-primary-column">
          <article class="query-total-section">
            <header class="chart-section-header">
              <span class="chart-title">Query total time <small id="query-total-rate" class="chart-rate-centered">{{queryRate}} qry/s&nbsp;&nbsp;load: {{queryLoad}}</small></span>
              <span class="chart-control-group chart-mode-tabs">
                <button type="button" id="chart-type-bar" class="chart-type-btn" aria-pressed="true">Bars</button>
                <button type="button" id="chart-type-line" class="chart-type-btn" aria-pressed="false">Lines</button>
              </span>
            </header>
            <div class="chartjs-wrap">
              <canvas id="chartjs-canvas"></canvas>
              <div id="query-total-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="chart-range-selection" class="chart-range-selection" hidden>
              <span id="chart-range-selection-text"></span>
              <button type="button" id="chart-range-selection-clear">Use preset range</button>
            </div>
          </article>

          <div class="top-chart-legend" aria-label="Chart series legend">
            {{#legend}}
              <button type="button" class="legend-series-toggle"
                      data-label="{{group}}" aria-pressed="true"
                      aria-label="Toggle {{group}}" title="{{group}}">
                <span class="legend-swatch" style="background-color: {{color}};"></span>
              </button>
            {{/legend}}
          </div>

        </div>

        <div class="top-primary-column">
          <article class="query-total-section">
            <header class="chart-section-header" role="toolbar" aria-label="Mean and Max chart controls">
              <span>Query statistics</span>
              <span class="chart-control-group chart-mode-tabs">
                <button type="button" id="top-mean-mode-both" class="chart-type-btn"
                        aria-pressed="true">Mean + Max</button>
                <button type="button" id="top-mean-mode-only" class="chart-type-btn"
                        aria-pressed="false">Mean</button>
                <button type="button" id="top-mean-mode-max" class="chart-type-btn"
                        aria-pressed="false">Max</button>
                <button type="button" id="top-mean-mode-count" class="chart-type-btn"
                        aria-pressed="false">Count</button>
              </span>
              <span id="top-mean-view-group" class="chart-control-group chart-mode-tabs">
                <button type="button" id="top-mean-view-dots" class="chart-type-btn"
                        aria-pressed="true">Dots</button>
                <button type="button" id="top-mean-view-lines" class="chart-type-btn"
                        aria-pressed="false">Lines</button>
              </span>
              <label class="chart-scale-toggle">
                <input type="checkbox" id="top-mean-scale-log"
                       aria-label="Use logarithmic scale">
                Log scale
              </label>
            </header>
            <div class="chartjs-wrap">
              <canvas id="top-mean-max-chart"></canvas>
              <div id="query-statistics-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
          </article>

          <div class="top-chart-legend" aria-label="Chart series legend">
            {{#legend}}
              <button type="button" class="legend-series-toggle"
                      data-label="{{group}}" aria-pressed="true"
                      aria-label="Toggle {{group}}" title="{{group}}">
                <span class="legend-swatch" style="background-color: {{color}};"></span>
              </button>
            {{/legend}}
          </div>
        </div>

        <details class="legend-toggle legend-toggle-wide">
          <summary>
            <span class="legend-toggle-icon" aria-hidden="true">
              <svg class="legend-icon-eye" viewBox="0 0 24 24" focusable="false">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
                <circle cx="12" cy="12" r="2.5"></circle>
              </svg>
              <svg class="legend-icon-eye-off" viewBox="0 0 24 24" focusable="false">
                <path d="m3 3 18 18"></path>
                <path d="M10.6 6.2A11.8 11.8 0 0 1 12 6c6.5 0 10 6 10 6a18 18 0 0 1-3.1 3.7"></path>
                <path d="M6.2 6.2C3.5 8.3 2 12 2 12s3.5 6 10 6c1.4 0 2.7-.3 3.8-.8"></path>
              </svg>
            </span>
            Legend
          </summary>
          <table class="legend-table">
            <thead>
              <tr>
                <th></th>
                <th>Group</th>
                <th>Total (ms)</th>
                <th>Executions</th>
                <th>Rate (/s)</th>
                <th>Avg (ms)</th>
                <th>Distinct queries</th>
              </tr>
            </thead>
            <tbody>
              {{#legend}}
                <tr>
                  <td>
                    <button type="button" class="legend-series-toggle"
                            data-label="{{group}}" aria-pressed="true">
                      <span class="legend-swatch" style="background-color: {{color}};"></span>
                    </button>
                  </td>
                  <td>
                    {{^other}}<a href="{{detailUrl}}">{{group}}</a>{{/other}}
                    {{#other}}{{group}}{{/other}}
                  </td>
                  <td>{{totalMs}}</td>
                  <td>{{executions}}</td>
                  <td>{{rate}}</td>
                  <td>{{avgMs}}</td>
                  <td>{{hashCount}}</td>
                </tr>
              {{/legend}}
            </tbody>
          </table>
        </details>
      </div>

      {{#showTopRankings}}
        <div class="top-ranking-grid">
          <article class="query-total-section">
            <header>Top by time</header>
            <div class="ranking-chart-wrap">
              <canvas id="top-by-time-chart"></canvas>
            </div>
          </article>
          <article class="query-total-section">
            <header>Top by mean</header>
            <div class="ranking-chart-wrap">
              <canvas id="top-by-mean-chart"></canvas>
            </div>
          </article>
        </div>
      {{/showTopRankings}}

      {{#datasourcePoolDashboard}}
        <div class="datasource-pool-grid">
          <article class="query-total-section datasource-pool-section">
            <header>Datasource pool size</header>
            <div class="chartjs-wrap">
              <canvas id="datasource-pool-chart"></canvas>
              <div id="datasource-pool-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
          </article>
          <article class="query-total-section datasource-pool-section">
            <header>Datasource pool wait and acquire time</header>
            <div class="chartjs-wrap">
              <canvas id="datasource-pool-timing-chart"></canvas>
              <div id="datasource-pool-timing-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
          </article>
        </div>
      {{/datasourcePoolDashboard}}

      {{#jvmDashboard}}
        <div class="jvm-grid">
          <article class="query-total-section jvm-section">
            <header>JVM memory by pod</header>
            <div class="chartjs-wrap">
              <canvas id="jvm-memory-chart"></canvas>
              <div id="jvm-memory-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="jvm-memory-legend" class="top-chart-legend jvm-legend" aria-label="JVM memory pod legend"></div>
          </article>
          <article class="query-total-section jvm-section">
            <header>JVM CPU usage (user + system)</header>
            <div class="chartjs-wrap">
              <canvas id="jvm-cpu-chart"></canvas>
              <div id="jvm-cpu-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
            <div id="jvm-cpu-legend" class="top-chart-legend jvm-legend" aria-label="JVM CPU pod legend"></div>
          </article>
        </div>
      {{/jvmDashboard}}

    {{/hasData}}

    <script type="application/json" id="chart-data">{{{chartDataJson}}}</script>
    <script type="application/json" id="top-mean-data">{{{meanMaxMeanJson}}}</script>
    <script type="application/json" id="top-max-data">{{{meanMaxMaxJson}}}</script>
    <script type="application/json" id="top-count-data">{{{meanMaxCountJson}}}</script>
    <script type="application/json" id="top-by-time-data">{{{topByTimeJson}}}</script>
    <script type="application/json" id="top-by-mean-data">{{{topByMeanJson}}}</script>
    <script type="application/json" id="datasource-pool-data">{{{datasourcePoolJson}}}</script>
    <script type="application/json" id="datasource-pool-timing-data">{{{datasourcePoolTimingJson}}}</script>
    <script type="application/json" id="web-api-data">{{{webApiJson}}}</script>
    <script type="application/json" id="web-api-mean-data">{{{webApiMeanJson}}}</script>
    <script type="application/json" id="web-api-max-data">{{{webApiMaxJson}}}</script>
    <script type="application/json" id="web-api-count-data">{{{webApiCountJson}}}</script>
    <script type="application/json" id="jvm-memory-data">{{{jvmMemoryJson}}}</script>
    <script type="application/json" id="jvm-cpu-data">{{{jvmCpuJson}}}</script>
    <script src="/static/vendor/chart.umd.min.js"></script>
    <script src="/static/dashboard-charts.js?v=8"></script>
    <script src="/static/query-total.js?v=6"></script>
    <script src="/static/datasource-pool.js?v=3"></script>
    <script src="/static/datasource-pool-timing.js?v=2"></script>
    <script src="/static/web-api.js?v=5"></script>
    <script src="/static/jvm.js?v=27"></script>
  {{/body}}
{{/fragments/layout}}
