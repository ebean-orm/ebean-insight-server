{{<fragments/layout}}
  {{$filters}}
    <form class="header-filters" method="get" action="/ux/metric-detail">
      <input type="hidden" name="label" value="{{label}}">
      <input type="hidden" name="app" value="{{app}}">
      <div id="custom-range-controls" class="custom-range-controls" hidden>
        <label>
          <input type="datetime-local" id="custom-range-from" aria-label="Custom range start">
        </label>
        <label>
          <input type="datetime-local" id="custom-range-to" aria-label="Custom range end">
        </label>
        <button type="submit" class="custom-range-apply">Apply</button>
      </div>
      <select name="env" aria-label="Environment" onchange="this.form.submit()">
        {{#envs}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/envs}}
      </select>
      <select name="range" aria-label="Time range" onchange="this.form.submit()">
        {{#ranges}}
          <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
        {{/ranges}}
      </select>
      <select name="tz" id="time-zone-select" aria-label="Chart timezone"
              onchange="this.form.requestSubmit()">
        <option value="browser">Browser time</option>
        <option value="utc">UTC</option>
      </select>
      <label id="auto-refresh-control" class="auto-refresh-control" hidden>
        <input type="checkbox" id="auto-refresh-toggle" aria-label="Enable automatic refresh">
        Auto
        <span class="auto-refresh-timer" aria-label="Seconds until refresh">
          <span id="auto-refresh-ring" class="auto-refresh-ring" aria-hidden="true"></span>
          <span id="auto-refresh-seconds">60s</span>
        </span>
        <span id="auto-refresh-status" class="auto-refresh-status" hidden></span>
      </label>
      <noscript><button type="submit">Apply</button></noscript>
    </form>
  {{/filters}}
  {{$body}}
    <link rel="stylesheet" href="/static/query-total.css?v=22">
    <link rel="stylesheet" href="/static/metric-detail.css?v=2">

    {{^hasData}}
      <article>
        <p>No data for <strong>{{label}}</strong> in the selected application / environment / range.</p>
      </article>
    {{/hasData}}

    {{#hasData}}
      <div class="metric-detail-chart-layout">
        <div class="metric-detail-chart-column">
          <article class="query-total-section">
            <header class="chart-section-header" role="toolbar" aria-label="Total chart controls">
                <span>Total query time</span>
                <span class="chart-control-group chart-mode-tabs">
                  <button type="button" id="metric-chart-type-bar" class="chart-type-btn"
                          aria-pressed="true">Bars</button>
                  <button type="button" id="metric-chart-type-line" class="chart-type-btn"
                          aria-pressed="false">Lines</button>
                </span>
            </header>
            <div class="chartjs-wrap chartjs-wrap-small">
                <canvas id="total-chart"></canvas>
                <div id="metric-total-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
          </article>
          <div class="top-chart-legend metric-hash-legend" aria-label="Query hash legend">
            {{#hashBreakdown}}
                <button type="button" class="legend-series-toggle hash-series-toggle"
                        data-label="{{hash}}" aria-pressed="true"
                        aria-label="Toggle {{hash}}" title="{{hash}}">
                  <span class="legend-swatch" style="background-color: {{color}}"></span>
                </button>
            {{/hashBreakdown}}
          </div>
        </div>

        <div class="metric-detail-chart-column">
          <article class="query-total-section">
            <header class="chart-section-header" role="toolbar" aria-label="Query statistics chart controls">
                <span>Query statistics</span>
                <span class="chart-control-group chart-mode-tabs">
                  <button type="button" id="metric-mean-mode-both" class="chart-type-btn"
                          aria-pressed="true">Mean + Max</button>
                  <button type="button" id="metric-mean-mode-only" class="chart-type-btn"
                          aria-pressed="false">Mean</button>
                  <button type="button" id="metric-mean-mode-max" class="chart-type-btn"
                          aria-pressed="false">Max</button>
                  <button type="button" id="metric-mean-mode-count" class="chart-type-btn"
                          aria-pressed="false">Count</button>
                </span>
                <span id="metric-mean-view-group" class="chart-control-group chart-mode-tabs">
                  <button type="button" id="metric-mean-view-dots" class="chart-type-btn"
                          aria-pressed="true">Dots</button>
                  <button type="button" id="metric-mean-view-lines" class="chart-type-btn"
                          aria-pressed="false">Lines</button>
                </span>
                <label id="metric-mean-scale-group" class="chart-scale-toggle">
                  <input type="checkbox" id="metric-mean-scale-log"
                         aria-label="Use logarithmic scale">
                Log scale
                </label>
            </header>
            <div class="chartjs-wrap chartjs-wrap-small">
                <canvas id="mean-chart"></canvas>
                <div id="metric-mean-tooltip" class="chart-html-tooltip" role="tooltip" aria-hidden="true"></div>
            </div>
          </article>
          <div class="top-chart-legend metric-hash-legend" aria-label="Query hash legend">
            {{#hashBreakdown}}
                <button type="button" class="legend-series-toggle hash-series-toggle"
                        data-label="{{hash}}" aria-pressed="true"
                        aria-label="Toggle {{hash}}" title="{{hash}}">
                  <span class="legend-swatch" style="background-color: {{color}}"></span>
                </button>
            {{/hashBreakdown}}
          </div>
        </div>
        <div id="metric-chart-range-selection" class="chart-range-selection" hidden>
          <span id="metric-chart-range-selection-text"></span>
          <button type="button" id="metric-chart-range-selection-clear">Use preset range</button>
        </div>
      </div>
      <article class="query-total-section hash-query-section">
        <header>Query hashes</header>
        <div class="hash-query-browser">
          <div class="hash-query-list">
            <table id="hash-query-table">
              <thead>
                <tr>
                  <th>Hash</th>
                  <th>Location</th>
                  <th class="numeric">Total (ms)</th>
                  <th class="numeric">Mean (ms)</th>
                </tr>
              </thead>
              <tbody id="hash-query-table-body">
                {{#hashBreakdown}}
                  <tr class="hash-query-row" data-hash="{{hash}}" data-color="{{color}}">
                    <td>
                      <button type="button" class="hash-query-select"
                              data-hash="{{hash}}" data-hash-url="{{hashUrl}}"
                              aria-label="Show SQL for {{hash}}"
                              title="{{hash}}">
                        <span class="hash-swatch" style="background-color: {{color}}"></span>
                        <code>{{displayHash}}</code>
                      </button>
                    </td>
                    <td class="hash-location"><code>{{location}}</code></td>
                    <td class="numeric">{{totalMs}}</td>
                    <td class="numeric">{{meanMs}}</td>
                  </tr>
                {{/hashBreakdown}}
                {{^hashBreakdown}}
                  <tr><td colspan="4">No hash-level data.</td></tr>
                {{/hashBreakdown}}
              </tbody>
            </table>
            <div id="hash-sql-sources" class="hash-sql-sources" hidden>
              {{#hashBreakdown}}
                <template class="hash-sql-source" data-hash="{{hash}}">{{sql}}</template>
              {{/hashBreakdown}}
            </div>
          </div>
          <aside id="hash-sql-inspector" class="hash-sql-inspector" aria-live="polite">
            <h4 id="hash-sql-title">Select a hash to view SQL</h4>
            <p id="hash-sql-location"></p>
            <pre><code id="hash-sql-content"></code></pre>
            <a id="hash-sql-open" href="#" hidden>View details</a>
          </aside>
        </div>
      </article>

      <article class="query-total-section">
        <header>Recently collected query plans</header>
        <table>
          <thead>
            <tr>
              <th>Env</th>
              <th>Hash</th>
              <th>Captured (UTC)</th>
              <th>Query time (ms)</th>
              <th>Capture count</th>
              <th>Shape changed</th>
            </tr>
          </thead>
          <tbody id="recent-plans-body">
            {{^recentPlans}}
              <tr><td colspan="6">No query plans collected for this label.</td></tr>
            {{/recentPlans}}
            {{#recentPlans}}
              <tr class="plan-row" data-hash="{{hash}}" data-color="{{color}}">
                <td>{{env}}</td>
                <td><span class="hash-swatch" style="background-color: {{color}}"></span><code>{{hash}}</code></td>
                <td><a href="{{url}}">{{whenCaptured}}</a></td>
                <td>{{queryTimeMs}}</td>
                <td>{{captureCount}}</td>
                <td>{{#shapeChanged}}<mark>Yes</mark>{{/shapeChanged}}{{^shapeChanged}}&mdash;{{/shapeChanged}}</td>
              </tr>
            {{/recentPlans}}
          </tbody>
        </table>
      </article>

      <article id="metric-query-family" class="query-total-section"{{^hasFamily}} hidden{{/hasFamily}}>
        <header>Query family</header>
        <p class="family-hint">
          Related queries sharing this label's root (parent finder query and its lazy-loaded fetch-path
          descendants). Bar width shows each row's total execution time relative to the busiest query in the family.
        </p>
        <table class="family-table">
          <thead>
            <tr>
              <th>Label</th>
              <th>Executions</th>
              <th class="numeric">Total (ms)</th>
              <th class="numeric">Mean (ms)</th>
            </tr>
          </thead>
          <tbody id="family-table-body">
            {{#family}}
              <tr class="family-row{{#current}} family-row-current{{/current}}">
                <td style="padding-left: {{indent}}px">
                  <a href="{{detailUrl}}">{{display}}</a>
                  <div class="family-bar-track"><div class="family-bar" style="width: {{pct}}%"></div></div>
                </td>
                <td>{{count}}</td>
                <td class="numeric">{{totalMs}}</td>
                <td class="numeric">{{meanMs}}</td>
              </tr>
            {{/family}}
          </tbody>
        </table>
      </article>
    {{/hasData}}

    <script type="application/json" id="total-chart-data">{{{totalChartDataJson}}}</script>
    <script type="application/json" id="mean-chart-data">{{{meanChartDataJson}}}</script>
    <script type="application/json" id="max-chart-data">{{{maxChartDataJson}}}</script>
    <script type="application/json" id="count-chart-data">{{{countChartDataJson}}}</script>
    <script src="/static/vendor/chart.umd.min.js"></script>
    <script src="/static/dashboard-charts.js?v=13"></script>
    <script src="/static/metric-detail.js?v=7"></script>
  {{/body}}
{{/fragments/layout}}
