<div class="hash-legend" aria-label="Query hash legend">
  <strong>Hash legend</strong>
  <ul>
    {{^hashBreakdown}}
      <li>No hash-level data.</li>
    {{/hashBreakdown}}
    {{#hashBreakdown}}
      <li class="hash-legend-item">
        <button type="button" class="hash-series-toggle"
                data-label="{{hash}}" aria-pressed="true"
                aria-label="Toggle {{hash}}">
          <span class="hash-swatch" style="background-color: {{color}}"></span>
        </button>
        <code>{{hash}}</code>
        {{#sqlUrl}}<a href="{{sqlUrl}}">SQL</a>{{/sqlUrl}}
      </li>
    {{/hashBreakdown}}
  </ul>
</div>
