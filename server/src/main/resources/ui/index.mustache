{{<fragments/layout}}
  {{$body}}
    <article>
      <header>Applications</header>
      <ul>
        {{#apps}}
          <li>
            {{#topUrl}}<a href="{{topUrl}}">{{name}}</a>{{/topUrl}}
            {{^topUrl}}<span>{{name}}</span>{{/topUrl}}
            {{#envs}}
              <a class="app-env-link" href="{{topUrl}}">{{name}}</a>
            {{/envs}}
            <small>
              <a href="{{datasourcePoolConfigUrl}}">
                {{#datasourcePoolEnabled}}Disable{{/datasourcePoolEnabled}}
                {{^datasourcePoolEnabled}}Enable{{/datasourcePoolEnabled}} datasource pool
              </a>
              ·
              <a href="{{webApiConfigUrl}}">
                {{#webApiEnabled}}Disable{{/webApiEnabled}}
                {{^webApiEnabled}}Enable{{/webApiEnabled}} web API
              </a>
            </small>
          </li>
        {{/apps}}
      </ul>
      {{^apps}}
        <p>No applications reporting yet.</p>
      {{/apps}}
    </article>
  {{/body}}
{{/fragments/layout}}
